<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <packaging>jar</packaging>

    <parent>
        <groupId>cc.uncarbon.module</groupId>
        <artifactId>helium-monolith</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>file-service</artifactId>
    <description>
        文件管理服务
    </description>
    <version>${revision}</version>

    <properties>
        <!-- 引用其他契约 -->
        <sys.version>${revision}</sys.version>
        <tenant.version>${revision}</tenant.version>
    </properties>

    <dependencies>
        <!-- 实现契约 -->
        <dependency>
            <groupId>cc.uncarbon.module</groupId>
            <artifactId>file-facade</artifactId>
            <version>${project.version}</version>
        </dependency>


        <!-- 引用其他契约 -->
        <dependency>
            <groupId>cc.uncarbon.module</groupId>
            <artifactId>commons</artifactId>
        </dependency>

        <dependency>
            <groupId>cc.uncarbon.module</groupId>
            <artifactId>sys-facade</artifactId>
            <version>${sys.version}</version>
        </dependency>

        <dependency>
            <groupId>cc.uncarbon.module</groupId>
            <artifactId>tenant-facade</artifactId>
            <version>${tenant.version}</version>
        </dependency>


        <!-- 引用框架启动包 -->
        <dependency>
            <groupId>cc.uncarbon.framework</groupId>
            <artifactId>helium-starter-db-mybatis-plus</artifactId>
        </dependency>

        <dependency>
            <groupId>cc.uncarbon.framework</groupId>
            <artifactId>helium-starter-db-dynamic-datasource</artifactId>
        </dependency>


        <!-- 引用其他第三方依赖 -->
        <!-- 为了引用 MultipartFile 类 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <!-- 对象存储工具类 https://gitee.com/dromara/x-file-storage -->
        <dependency>
            <groupId>org.dromara.x-file-storage</groupId>
            <artifactId>x-file-storage-spring</artifactId>
        </dependency>

        <!-- MinIO 依赖包 -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
        </dependency>
    </dependencies>
</project>
